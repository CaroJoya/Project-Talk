{
  "services": {
    "frontend": {
      "root": ".",
      "framework": null 
    },
    "backend": {
      "root": ".",
      "entrypoint": "server:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}